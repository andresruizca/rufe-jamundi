# ── Bot de Gestión del Riesgo ──────────────────────────────────────────
# Este archivo es la PLANTILLA. El .env real vive junto al de WaSphere y
# NUNCA se versiona.

# Base de datos. Dentro de Docker el host es el nombre del servicio.
# Puede ser la misma instancia de Postgres que WaSphere, en OTRA base.
DATABASE_URL=postgresql://wasphere_riesgo:CAMBIAR@postgres:5432/bot_riesgo

# Puerto en el que escucha este servicio.
PORT=3010

# ── WaSphere ───────────────────────────────────────────────────────────
# wa-server, dentro de la red de Docker.
WASPHERE_BASE_URL=http://wa-server:3001
# Token de API con alcance de envío (Dashboard → API Keys).
WASPHERE_API_TOKEN=
# Id de la sesión conectada. PENDIENTE: no existe hasta escanear el QR.
WASPHERE_SESSION_ID=

# Secreto con el que WaSphere firma los webhooks. Debe ser EXACTAMENTE el
# mismo valor que WEBHOOK_SIGNING_SECRET en el .env de WaSphere.
WEBHOOK_SIGNING_SECRET=

# Retardo aleatorio de WaSphere: 4-12 s. 30 s deja margen; bajarlo hace que
# envíos exitosos den timeout y el reintento DUPLIQUE el mensaje.
WASPHERE_TIMEOUT_MS=30000
