     /** Ocho videos de ocho trozos, con margen de reintento por mala señal. */
     private const MAX_TROZOS_HORA = 300;
 
+    /**
+     * Cuánto se le permite a UNA conexión cuando quien pide se identifica como
+     * dispositivo. Ver `limitar()`.
+     *
+     * Ocho veces el tope por dispositivo: una brigada que ayuda a veinte
+     * familias en una vereda y baja al pueblo a sincronizar cabe holgada, y un
+     * robot desde una sola conexión sigue teniendo un techo.
+     */
+    private const FACTOR_POR_CONEXION = 8;
+
+    /**
+     * El identificador de instalación del APK, si viene y es plausible.
+     *
+     * Lo genera el teléfono al instalarse y no identifica a nadie: es un número
+     * aleatorio que solo sirve para repartir la cuota. Se acepta hexadecimal de
+     * 16 a 64 caracteres —lo que produce `random_bytes`— y cualquier otra cosa
+     * se ignora como si no hubiera venido.
+     */
+    private function dispositivo(Request $req): ?string
+    {
+        $id = trim($req->texto('dispositivo_id'));
+
+        if ($id === '') {
+            $id = trim((string) ($_SERVER['HTTP_X_DISPOSITIVO_ID'] ?? ''));
+        }
+
+        return preg_match('/^[a-f0-9]{16,64}$/i', $id) === 1 ? strtolower($id) : null;
+    }
+
+    /**
+     * Consume cuota repartiendo por dispositivo cuando se puede.
+     *
+     * El problema que resuelve: `Limite` contaba solo por IP, y los operadores
+     * móviles colombianos usan CGNAT —una vereda entera sale por la misma IP
+     * pública—. Con cinco envíos por hora y por IP, la sexta familia de un
+     * corregimiento recibía un rechazo por hacer exactamente lo que se le pidió.
+     *
+     * Cuando hay dispositivo se cuentan DOS presupuestos, con contadores
+     * separados:
+     *
+     *   • por dispositivo → el tope de siempre, que es el de una persona;
+     *   • por conexión    → un techo más alto, que sigue frenando a un robot.
+     *
+     * Sin dispositivo —el formulario web— nada cambia: se cuenta por IP con el
+     * tope original. Es un ensanche deliberado y acotado: quien falsifique
+     * identificadores consigue el techo por conexión, no el infinito.
+     */
+    private function limitar(
+        Request $req,
+        string $accion,
+        int $maximo,
+        string $mensaje = 'Ha realizado demasiadas solicitudes. Espere unos minutos e intente de nuevo.'
+    ): void {
+        $dispositivo = $this->dispositivo($req);
+
+        if ($dispositivo === null) {
+            Limite::consumir($accion, $req->ip(), $maximo, 3600, $mensaje);
+
+            return;
+        }
+
+        Limite::consumir($accion.'.disp', $dispositivo, $maximo, 3600, $mensaje);
+        Limite::consumir(
+            $accion.'.conexion',
+            $req->ip(),
+            $maximo * self::FACTOR_POR_CONEXION,
+            3600,
+            $mensaje
+        );
+    }
+
