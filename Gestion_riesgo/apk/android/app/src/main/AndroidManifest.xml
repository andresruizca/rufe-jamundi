<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".SgrApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <!--
        La cámara y la galería NO las declara el complemento de Capacitor: hay
        que pedirlas aquí. Se descubrió leyendo los permisos del APK ya
        compilado, no el manifiesto — el APK anterior salió sin CAMERA y la
        cámara habría fallado en el teléfono sin decir por qué.
    -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
        El micrófono. `GrabadorVideo` pide `audio: true` en getUserMedia, y
        Capacitor solo concede el permiso al WebView si la aplicación lo tiene
        declarado: `BridgeWebChromeClient.onPermissionRequest` mapea
        AUDIO_CAPTURE a RECORD_AUDIO y MODIFY_AUDIO_SETTINGS.

        Sin estas dos líneas la grabación falla — el WebView pide permiso,
        Capacitor lo deniega y `getUserMedia` rechaza. Y no dice por qué.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Galería. Android 13 partió el permiso en dos: el nuevo por tipo de
         medio, y el viejo solo hasta Android 12. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- El teléfono puede no tener cámara y la aplicación sigue sirviendo: se
         puede adjuntar desde la galería. `required="false"` evita que Play y
         los instaladores la descarten en esos aparatos. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
