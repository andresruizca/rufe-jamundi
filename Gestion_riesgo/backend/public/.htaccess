# API del Sistema de Gestión del Riesgo — Jamundí
#
# En producción este archivo queda en grj.oticjamundi.com/api/.htaccess, con
# todo el backend aplanado en esa misma carpeta. Como el hosting solo ofrece
# un directorio para el sitio, el código no puede vivir por encima del
# document root y hay que negarle el acceso web explícitamente.

<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Apache de cPanel no propaga la cabecera Authorization a PHP por CGI/FastCGI.
  # Sin esto, todas las peticiones autenticadas llegarían como anónimas.
  RewriteCond %{HTTP:Authorization} .
  RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # Todo pasa por el front controller salvo los archivos que existan de verdad.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  # Las respuestas de la API dependen de la sesión: nunca deben quedar en caché.
  Header set Cache-Control "no-store"
</IfModule>

Options -Indexes

# config.php contiene la contraseña de MySQL. Si PHP dejara de interpretarse por
# un error de configuración del servidor, sin esta regla el archivo se
# descargaría en texto plano.
<FilesMatch "^config.*\.php$">
  Require all denied
</FilesMatch>

<FilesMatch "\.(sql|md|json|lock|ini|log)$">
  Require all denied
</FilesMatch>
