# INTRANET-JAMUNDI es un repositorio independiente, con su propio remoto
# (oficina-tic-jamundi/intranet-jamundi). Se excluye a propósito: anidarlo aquí
# rompería su historia y arrastraría su .env con credenciales.
INTRANET-JAMUNDI/

# Dependencias y artefactos de build
node_modules/
vendor/
dist/
build/
.svelte-kit/
.output/
*.tsbuildinfo

# Entorno y secretos — nunca versionar
.env
.env.*
!.env.example

# Configuración de producción del backend: contiene la contraseña de MySQL.
# La plantilla versionada es backend/config.example.php.
Gestion_riesgo/backend/config.php
VIVE-HELP-MANAGER/backend/config.php

# Sistema operativo / editor
.DS_Store
Thumbs.db
*.swp
.idea/

# Logs y temporales
*.log
npm-debug.log*
storage/logs/
tmp/

# Otros sistemas que viven en esta misma carpeta y tienen su propio repositorio.
# Se ignoran a propósito: el 21 de agosto de 2026 un `git add -A` los arrastró
# enteros a un commit de Gestion_riesgo, y con ellos dos hojas de cálculo con la
# cédula y el teléfono de 1.722 personas damnificadas, en un repositorio público.
cuenta-conmigo/
VIVE-HELP-MANAGER/

# Caché de herramientas locales: 52 MB de índice que no es código y que GitHub
# rechaza por tamaño.
.codetree/

# Datos personales del censo. NUNCA al repositorio.
#
# El archivo del RUD trae 3.184 nombres, cédulas y teléfonos de familias
# damnificadas, y el CSV de revisión es un extracto de los mismos datos. Este
# repositorio vive en GitHub: un commit con esto dentro no se borra del
# historial de nadie que ya lo haya clonado.
*.xlsx
Gestion_riesgo/backend/scripts/revision-rud.csv

# ── Datos personales y secretos: nunca versionados ──────────────────────────
#
# El 28 de agosto de 2026 una auditoría encontró dos cosas publicadas en un
# repositorio que estaba en PÚBLICO: un token vivo de Zavu —con el que
# cualquiera manda WhatsApp desde el número oficial de la Alcaldía— y doce
# cédulas con fecha de nacimiento de personas del censo.
#
# Las reglas de abajo son anchas a propósito. Un CSV de trabajo o un volcado de
# la base casi siempre salen de consultar datos reales, y el coste de ignorar
# uno que no hacía falta es cero comparado con publicar el que sí.
Gestion_riesgo/backend/scripts/*.csv
Gestion_riesgo/backend/scripts/*.xls
Gestion_riesgo/backend/scripts/*.xlsx
Estrategia_Gestion_Call_center/api_zv.md
*.sqlite
*.dump
